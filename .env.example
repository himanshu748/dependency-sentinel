# Copy this template to backend/.env, not the repository root.
# Leave AWS_PROFILE unset to use the standard AWS credential chain.
# AWS_PROFILE=your-profile
DEPENDENCY_SENTINEL_AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
# Optional external model: explicitly select openai-compatible and fill all three fields.
LLM_PROVIDER=bedrock
LLM_MODEL_ID=
LLM_BASE_URL=
LLM_API_KEY=
DEPENDENCY_SENTINEL_FIXTURE_MODE=true
DEPENDENCY_SENTINEL_LOCAL_LIVE_UI=false
DEPENDENCY_SENTINEL_AGENTCORE_RUNTIME_ARN=
DEPENDENCY_SENTINEL_DATABASE_PATH=./data/dependency-sentinel.sqlite3
DEPENDENCY_SENTINEL_REPOSITORY_ROOT=../fixtures
DEPENDENCY_SENTINEL_EVIDENCE_MODE=fixture
DEPENDENCY_SENTINEL_WORKSPACE_ROOT=./data/workspaces
DEPENDENCY_SENTINEL_EVIDENCE_FIXTURE_PATH=../fixtures/evidence
DEPENDENCY_SENTINEL_COMMAND_TIMEOUT_SECONDS=120
